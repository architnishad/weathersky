# =========================
# GET WEATHER DATA
# =========================

def request_data(endpoint, city_name):
    response = requests.get(
        f"{BASE_URL}/{endpoint}",
        params={
            "q": city_name,
            "appid": API_KEY,
            "units": "metric"
        },
        timeout=10
    )

    data = response.json()

    if response.status_code != 200:
        raise ValueError(
            data.get("message", "Request failed")
        )

    return data


# =========================
# WEATHER ICON
# =========================

def weather_icon(icon_code, size):
    url = f"https://openweathermap.org/img/wn/{icon_code}@2x.png"

    response = requests.get(
        url,
        timeout=10
    )

    response.raise_for_status()

    image = Image.open(
        BytesIO(response.content)
    )

    return ctk.CTkImage(
        light_image=image,
        dark_image=image,
        size=size
    )


# =========================
# GET WEATHER
# =========================

def get_weather():

    selected_city = city_entry.get().strip()

    if not selected_city:
        message_label.configure(
            text="Please select or enter a city",
            text_color="red"
        )
        return

    try:
        current_data = request_data(
            "weather",
            selected_city
        )

        update_current_weather(
            current_data
        )

        update_forecast(
            selected_city
        )

        message_label.configure(
            text="Weather updated successfully",
            text_color="green"
        )

    except ValueError:
        message_label.configure(
            text="City not found",
            text_color="red"
        )

    except requests.RequestException:
        message_label.configure(
            text="Internet connection error",
            text_color="red"
        )


# =========================
# CURRENT WEATHER
# =========================

def update_current_weather(data):

    main = data["main"]
    weather = data["weather"][0]
    system = data["sys"]

    location_label.configure(
        text=f"{data['name']}, {system['country']}"
    )

    temperature_label.configure(
        text=f"{main['temp']:.0f}°C"
    )

    weather_label.configure(
        text=weather["main"]
    )

    description_label.configure(
        text=weather["description"].title()
    )

    humidity_label.configure(
        text=f"Humidity: {main['humidity']}%"
    )

    wind_label.configure(
        text=f"Wind: {data['wind']['speed']} m/s"
    )

    pressure_label.configure(
        text=f"Pressure: {main['pressure']} hPa"
    )

    feels_label.configure(
        text=f"Feels Like: {main['feels_like']:.0f}°C"
    )

    sunrise_label.configure(
        text=f"Sunrise: "
             f"{datetime.fromtimestamp(system['sunrise']):%I:%M %p}"
    )

    sunset_label.configure(
        text=f"Sunset: "
             f"{datetime.fromtimestamp(system['sunset']):%I:%M %p}"
    )

    icon_label.configure(
        image=weather_icon(
            weather["icon"],
            (100, 100)
        ),
        text=""
    )


# =========================
# 5-DAY FORECAST
# =========================

def update_forecast(city_name):

    data = request_data(
        "forecast",
        city_name
    )

    # Remove old forecast cards
    for widget in forecast_frame.winfo_children():
        widget.destroy()

    # Select one forecast around 12 PM for each day
    days = [
        item
        for item in data["list"]
        if "12:00:00" in item["dt_txt"]
    ][:5]

    for item in days:
        create_card(item)


# =========================
# FORECAST CARD
# =========================

def create_card(data):

    card = ctk.CTkFrame(
        forecast_frame,
        width=200,
        height=240,
        corner_radius=15,
        fg_color="white"
    )

    card.pack(
        side="left",
        expand=True,
        fill="both",
        padx=6
    )

    main = data["main"]
    weather = data["weather"][0]

    # Date
    ctk.CTkLabel(
        card,
        text=datetime.fromtimestamp(
            data["dt"]
        ).strftime("%a\n%d %b"),
        font=("Arial", 18, "bold"),
        text_color="black"
    ).pack(
        pady=8
    )

    # Weather icon
    ctk.CTkLabel(
        card,
        image=weather_icon(
            weather["icon"],
            (65, 65)
        ),
        text=""
    ).pack()

    # Temperature
    ctk.CTkLabel(
        card,
        text=f"{main['temp']:.0f}°C",
        font=("Arial", 26, "bold"),
        text_color="#1976D2"
    ).pack(
        pady=2
    )

    # Weather condition
    ctk.CTkLabel(
        card,
        text=weather["main"],
        font=("Arial", 16),
        text_color="black"
    ).pack()

    # Humidity
    ctk.CTkLabel(
        card,
        text=f"Humidity: {main['humidity']}%",
        font=("Arial", 16),
        text_color="black"
    ).pack(
        pady=4
    )


